{
  "name": "mystery-session-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 8080",
    "verify:logic": "esbuild verify/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=warning && node node_modules/.cache/verify.mjs",
    "verify:ui": "esbuild verify/ui-smoke.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/ui-smoke.cjs --log-level=warning --jsx=automatic && node node_modules/.cache/ui-smoke.cjs",
    "verify": "npm run verify:logic && npm run verify:ui"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
